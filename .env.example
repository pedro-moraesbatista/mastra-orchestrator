OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
MASTRA_PORT=4111
MASTRA_MODEL_PROVIDER=ollama-cloud
MASTRA_MODEL_NAME=glm-5.2
OLLAMA_API_KEY=your-ollama-cloud-api-key-here
LOG_LEVEL=info
OPENCODE_ALLOWED_PATHS=

# Workspace
WORKSPACE_DIR=./workspace
WORKSPACE_ISOLATION=none
WORKSPACE_ALLOW_NETWORK=true
WORKSPACE_REQUIRE_APPROVAL=false
WORKSPACE_DISABLE_SHELL=false

# MCP Servers (JSON)
# Azure DevOps (local, Azure CLI auth)
MCP_SERVERS={"azure-devops":{"id":"azure-devops","command":"npx","args":["-y","@azure-devops/mcp","YOUR_ORG","--authentication","azcli","-d","core","work","work-items","repositories","pipelines","wiki","test-plans"]}}